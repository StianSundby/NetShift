<Window x:Class="NetShiftST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetShift"
        Width="1120"
        Height="700"
        MinWidth="1120"
        MinHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0C121D"
        Foreground="#EEF4FC"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid" Background="#0C121D" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="200"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition x:Name="SettingsColumn" Width="310"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition x:Name="GraphsColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" VerticalAlignment="Top">
            <Border Background="#67E8CA" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
                <TextBlock Text="⇄" FontSize="23" Foreground="#102B29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="NetShift" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="NETWORK CONTROL" Foreground="#A9B8CD" FontSize="10" Margin="16,11,0,0"/>
        </StackPanel>
        <StackPanel x:Name="NormalWindowControls" shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="−" Width="36" Padding="0" Margin="0,0,6,0" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeButton_Click"/>
            <Button Content="×" Width="36" Padding="0" ToolTip="Close window" AutomationProperties.Name="Close window" Click="CloseButton_Click"/>
        </StackPanel>
        <Grid x:Name="MainPanel" Grid.Row="1">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="NetworkStatusText" Text="Checking network..." FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="NetworkDetailText" Foreground="#67E8CA" TextWrapping="Wrap" Margin="0,7,0,24"/>
                        <Border Height="1" Background="#2B374A" Margin="0,0,0,24"/>
                        <TextBlock Text="Switch connection" Style="{StaticResource Caption}"/>
                        <Button Content="Force Ethernet" Style="{StaticResource PrimaryButton}" Click="ForceEthernetButton_Click" Margin="0,5,0,10"/>
                        <Button Content="Force Wi-Fi" Click="ForceWiFiButton_Click"/>
                        <TextBlock x:Name="FeedbackText" Margin="0,20,0,0" Foreground="#A9B8CD" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="A smaller view of your network." Foreground="#A9B8CD" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button x:Name="MonitorModeButton" Content="Open monitor" Click="MonitorModeButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="SettingsPanel" Grid.Row="1" Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold"/>
                            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Visibility="Collapsed" Click="SaveButton_Click"/>
                        </Grid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Wi-Fi adapter" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="WiFiNameTextBox" TextChanged="Setting_Changed" ToolTip="Exact Windows interface name" AutomationProperties.Name="Wi-Fi adapter"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Ethernet adapter" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="EthernetNameTextBox" TextChanged="Setting_Changed" ToolTip="Exact Windows interface name" AutomationProperties.Name="Ethernet adapter"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Connectivity target" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="PingTargetTextBox" TextChanged="Setting_Changed" ToolTip="Hostname or IP address to ping" AutomationProperties.Name="Connectivity target"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Check interval" VerticalAlignment="Center" Foreground="#C2D0E2"/>
                            <TextBox x:Name="CheckIntervalTextBox" Grid.Column="1" TextChanged="Setting_Changed" ToolTip="Seconds between automatic checks" AutomationProperties.Name="Check interval"/>
                            <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#A9B8CD" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Failed checks" VerticalAlignment="Center" Foreground="#C2D0E2"/>
                            <TextBox x:Name="FailureThresholdTextBox" Grid.Column="1" TextChanged="Setting_Changed" ToolTip="Consecutive failures before Wi-Fi failover" AutomationProperties.Name="Failed checks"/>
                            <TextBlock Grid.Column="2" Text="checks" VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#A9B8CD" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Successful checks" VerticalAlignment="Center" Foreground="#C2D0E2"/>
                            <TextBox x:Name="SuccessThresholdTextBox" Grid.Column="1" TextChanged="Setting_Changed" ToolTip="Consecutive successes before an Ethernet attempt" AutomationProperties.Name="Successful checks"/>
                            <TextBlock Grid.Column="2" Text="checks" VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#A9B8CD" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Wi-Fi minimum uptime" VerticalAlignment="Center" Foreground="#C2D0E2"/>
                            <TextBox x:Name="MinimumWiFiUptimeTextBox" Grid.Column="1" TextChanged="Setting_Changed" ToolTip="Minimum seconds on Wi-Fi before returning to Ethernet" AutomationProperties.Name="Wi-Fi minimum uptime"/>
                            <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#A9B8CD" FontSize="11"/>
                        </Grid>
                        <Border Height="1" Background="#2B374A" Margin="0,8,0,10"/>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
                        <CheckBox x:Name="PreventAutoSwitchingCheckBox" Content="Prevent auto-switching" Checked="PreventAutoSwitching_Changed" Unchecked="PreventAutoSwitching_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="GraphArea" Grid.Row="1" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MonitorHeaderRow" Height="0"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="MonitorHeader" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorStatusText" Text="Checking network..." VerticalAlignment="Center" Foreground="#A9B8CD"/>
                <StackPanel x:Name="MonitorControls" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AlwaysOnTopButton" Content="Pin" Click="AlwaysOnTopButton_Click" Margin="0,0,6,0"/>
                    <Button Content="Full View" Click="FullViewButton_Click" Margin="0,0,6,0"/>
                    <Button Content="−" Width="36" Padding="0" ToolTip="Minimize" Click="MinimizeButton_Click" Margin="0,0,6,0"/>
                    <Button Content="×" Width="36" Padding="0" ToolTip="Exit NetShift" Click="MonitorExitButton_Click"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ChartsPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Throughput" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Mbps" HorizontalAlignment="Right" Foreground="#A9B8CD" VerticalAlignment="Center"/>
                        </Grid>
                        <lvc:CartesianChart x:Name="ThroughputChart" Grid.Row="1" Background="#151D2A" LegendPosition="Top" PreviewMouseWheel="Chart_PreviewMouseWheel" PreviewMouseLeftButtonDown="Chart_PreviewMouseLeftButtonDown"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Latency" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="ms" HorizontalAlignment="Right" Foreground="#A9B8CD" VerticalAlignment="Center"/>
                        </Grid>
                        <lvc:CartesianChart x:Name="PingChart" Grid.Row="1" Background="#151D2A" LegendPosition="Hidden" PreviewMouseWheel="Chart_PreviewMouseWheel" PreviewMouseLeftButtonDown="Chart_PreviewMouseLeftButtonDown"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="0,6,0,0" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LiveButton" Content="Live" MinHeight="24" Padding="10,2" FontSize="11" ToolTip="Show the latest minute and follow new samples" Click="LiveButton_Click"/>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                        <Hyperlink NavigateUri="https://github.com/StianSundby/NetShift" RequestNavigate="Hyperlink_RequestNavigate">View on GitHub ↗</Hyperlink>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>